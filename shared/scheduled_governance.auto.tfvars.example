# ─────────────────────────────────────────────────────────────────────────────
# Scheduled governance job — LEGACY envs only (deprecated) — opt-in snippet
# ─────────────────────────────────────────────────────────────────────────────
# Deterministic envs: not supported. make refuses enable_scheduled_governance =
# true there; schedule make maintain ENV=<env> (from the last released commit,
# clean tree, on the deployment machine) or make audit-rulebook / make
# audit-schema with your own scheduler. See shared/docs/scheduled-governance.md.
#
# Legacy envs: these variables are consumed by the data_access root
# (roots/data_access/scheduled_governance.tf). They are DISABLED by default.
# To enable the job, copy the block below into the legacy env's env.auto.tfvars
# (e.g. aws/envs/prod/env.auto.tfvars), then run `make apply ENV=prod`.
# ─────────────────────────────────────────────────────────────────────────────

# Turn the scheduled job on. Default is false.
enable_scheduled_governance = true

# Which environment the scan targets, and which cloud subdir holds its envs/.
scheduled_governance_env   = "prod"
scheduled_governance_cloud = "aws" # "aws" | "azure"

# Default: read-only schema + rulebook audits. Set "legacy" only to retain the
# old audit -> generate-delta -> coverage checkout-local flow.
scheduled_governance_mode = "check"

# Legacy-only: used by run_scheduled_governance.py --step all for its
# generate-delta step. The default read-only check warns and ignores it.
# scheduled_governance_catalog = "prod_fin"

# Cadence (Quartz cron) and timezone. Default: daily at 06:00 UTC.
scheduled_governance_cron     = "0 0 6 * * ?"
scheduled_governance_timezone = "UTC"

# Repo the job checks out to run the existing steady-state entrypoints. The
# checkout provides CODE only. Required when enable_scheduled_governance = true.
scheduled_governance_git_url      = "https://github.com/<org>/<repo>"
scheduled_governance_git_branch   = "main"
scheduled_governance_git_provider = "gitHub" # gitHub | gitLab | bitbucketCloud | azureDevOpsServices | ...

# Runtime-visible envs root. REQUIRED when enabled: the job's Git checkout holds
# only committed files, and the upstream GenieRails repo doesn't commit envs/.
# It must contain account/abac.auto.tfvars plus prod/ (or the selected env) with
# env.auto.tfvars, data_access/, and optionally generated/. The wrapper copies
# both into its ephemeral checkout. Never put auth.auto.tfvars or any other
# secret here: check mode authenticates as the job's run-as identity.
scheduled_governance_config_source = "/Volumes/main/governance/genierails/envs"

# Optional: who to email when the job fails. The notification links to the run;
# the actionable finding details are in the run output.
scheduled_governance_notification_emails = ["governance-team@example.com"]

# Optional: PyPI packages installed into the serverless environment. Defaults
# cover the read-only checks; legacy delta may need an LLM provider package.
# scheduled_governance_dependencies = ["python-hcl2>=7.3.1,<8", "databricks-sdk", "pyyaml", "requests"]

# Optional: override the generated job name.
# scheduled_governance_job_name = "GenieRails steady-state governance (prod)"
